# ================================================================
# TENANTFLOW SAAS PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# ================================================================
# Copy this file to `.env` in the backend directory before running.

# ----------------------------------------------------------------
# 1. SERVER CONFIGURATION
# ----------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ----------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas / Local)
# ----------------------------------------------------------------
# Replace with your MongoDB Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/TenantFlow?retryWrites=true&w=majority

# ----------------------------------------------------------------
# 3. JWT AUTHENTICATION & SECURITY
# ----------------------------------------------------------------
# Secret key used for signing JWT tokens (use a long random string in production)
JWT_SECRET=super_secret_jwt_key_tenantflow_2026_change_in_production
JWT_EXPIRES_IN=1d

# ----------------------------------------------------------------
# 4. AWS S3 CLOUD STORAGE (Phase 10 Configuration)
# ----------------------------------------------------------------
# Set to 'true' to upload files directly to AWS S3, or 'false' for local disk storage
USE_AWS_S3=false

# AWS Region where your S3 Bucket is hosted (e.g. ap-south-1, us-east-1)
AWS_REGION=ap-south-1

# AWS IAM Access Key ID (From AWS Console -> IAM -> Access Keys)
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX

# AWS IAM Secret Access Key (From AWS Console -> IAM -> Access Keys)
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Name of your AWS S3 Bucket
AWS_S3_BUCKET=tenantflow-storage-bucket

# ----------------------------------------------------------------
# 5. REDIS CACHING & QUEUES (Phase 11 Configuration)
# ----------------------------------------------------------------
# Option 1: Use REDIS_URL for cloud providers (Upstash, Redis Cloud, etc.)
REDIS_URL=rediss://default:your_password@your-redis-host.upstash.io:6379

# Option 2: Use separate Host/Port/Password (if not using URL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
